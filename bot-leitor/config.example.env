# ── Copie para .env e preencha ─────────────────────────────────────────
# (o arquivo .env NÃO vai para o git — está no .gitignore)

# UID do SEU usuário no HomeMatch. É onde os imóveis serão gravados.
# Como descobrir: abra o HomeMatch logado, aperte F12 > Console e rode:
#   firebase.auth().currentUser.uid
HM_UID=

# Caminho do service-account.json baixado do Firebase Console
# (Configurações do projeto > Contas de serviço > Gerar nova chave privada)
HM_FIREBASE_SA=./service-account.json

# Banco (já é o do HomeMatch; só mude se trocar de projeto)
HM_DB_URL=https://homematch-crm-default-rtdb.firebaseio.com

# Em qual grupo ouvir. Duas formas (use UMA):
#  1) Por JID exato (mais seguro) — rode o bot uma vez e copie o JID que ele lista:
HM_GRUPOS_JID=
#  2) Ou por parte do nome do grupo (mais fácil):
HM_GRUPO_NOME=

# Confiança mínima para gravar uma oferta (0–100). 60 é um bom começo.
HM_MIN_CONFIANCA=60

# Pasta onde a sessão do WhatsApp fica salva (não precisa mexer)
HM_AUTH_DIR=./auth
